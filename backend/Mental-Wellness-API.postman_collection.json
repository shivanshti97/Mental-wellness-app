          "raw": "{\n  \"title\": \"My First Document\",\n  \"description\": \"This is a test document for my MongoDB collection\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/add",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "add"]
        },
        "description": "Add a new document to your personal collection"
      },
      "response": []
    },
    {
